"https://wordpress-plugins.luongovincenzo.it/plugin/wp-adsterra-dashboard"
msgstr ""
"https://wordpress-plugins.luongovincenzo.it/plugin/wp-adsterra-dashboard"

#. Description of the plugin
#: index.php
msgid "Shows your Adsterra publisher earnings in the WordPress dashboard."
msgstr ""
"Mostra i guadagni del tuo account publisher Adsterra nella bacheca di "
"WordPress."

#. Author of the plugin
#: index.php
msgid "Vincenzo Luongo"
msgstr "Vincenzo Luongo"

#. Author URI of the plugin
#: index.php
msgid "https://www.luongovincenzo.it/"
msgstr "https://www.luongovincenzo.it/"

#: index.php:121
msgid "Refreshing…"
msgstr "Aggiornamento…"

#: index.php:122
msgid "Something went wrong. Please try again."
msgstr "Si è verificato un errore. Riprova."

#: index.php:123
msgid "Total"
msgstr "Totale"

#: index.php:129
msgid "Settings"
msgstr "Impostazioni"

#: index.php:135 index.php:136
msgid "Adsterra Settings"
msgstr "Impostazioni Adsterra"

#: index.php:148
msgid ""
"Invalid API token: it must be exactly 32 lowercase letters and digits. The "
"previous token has been kept."
msgstr ""
"Token API non valido: deve contenere esattamente 32 lettere minuscole e "
"cifre. È stato mantenuto il token precedente."

#: index.php:163
msgid "Invalid domain. The previous one has been kept."
msgstr "Dominio non valido. È stato mantenuto quello precedente."

#: index.php:188
msgid "Adsterra Earnings Dashboard"
msgstr "Guadagni Adsterra"

#: index.php:211
msgid "Adsterra Dashboard Settings"
msgstr "Impostazioni Adsterra Dashboard"

#: index.php:212
msgid ""
"Connect your Adsterra account to see your earnings in the WordPress "
"dashboard."
msgstr ""
"Collega il tuo account Adsterra per vedere i guadagni nella bacheca di "
"WordPress."

#: index.php:228 index.php:231
msgid "Enable Dashboard Widget"
msgstr "Attiva il widget in bacheca"

#: index.php:238
msgid "API Token"
msgstr "Token API"

#: index.php:244
msgid "32-character API token"
msgstr "Token API di 32 caratteri"

#. translators: %s: URL of the Adsterra API token page
#: index.php:251
#, php-format
msgid ""
"Generate a token on the <a href=\"%s\" target=\"_blank\" rel=\"noopener "
"noreferrer\">Adsterra API page</a> and paste it here."
msgstr ""
"Genera un token nella <a href=\"%s\" target=\"_blank\" rel=\"noopener "
"noreferrer\">pagina API di Adsterra</a> e incollalo qui."

#: index.php:259
msgid "Domain"
msgstr "Dominio"

#: index.php:262
msgid "All Domains"
msgstr "Tutti i domini"

#: index.php:268
msgid "Choose \"All Domains\" for combined statistics, or a single domain."
msgstr ""
"Scegli \"Tutti i domini\" per le statistiche complessive, oppure un singolo "
"dominio."

#: index.php:274
msgid "Save a valid API token to choose a domain."
msgstr "Salva un token API valido per scegliere un dominio."

#: index.php:281
msgid "Save Settings"
msgstr "Salva impostazioni"

#. translators: %s: settings page URL
#: index.php:402
#, php-format
msgid ""
"The widget is disabled or the API token is missing. <a href=\"%s\">Open the "
"settings</a> to set it up."
msgstr ""
"Il widget è disattivato o manca il token API. <a href=\"%s\">Apri le "
"impostazioni</a> per configurarlo."

#. translators: %s: settings page URL
#: index.php:416
#, php-format
msgid "Check your API token in the <a href=\"%s\">settings</a>."
msgstr "Controlla il token API nelle <a href=\"%s\">impostazioni</a>."

